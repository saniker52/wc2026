<%- include('partials/header', { currentPage: 'leaderboard' }) %>

<div class="page">
  <div class="container">

    <div class="section-header" style="margin-bottom:16px">
      <div>
        <div class="section-title">🏆 Leaderboard</div>
        <div class="section-subtitle">Updated: <%= updatedAt %> (Kuwait Time)</div>
      </div>
    </div>

    <div class="card" style="padding:0;overflow:hidden">
      <% if (rows.length === 0) { %>
        <div class="text-center text-muted" style="padding:40px">No players yet.</div>
      <% } else { %>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:.82rem;min-width:680px">
          <thead>
            <tr style="background:rgba(255,255,255,.04);color:var(--text-dim);font-size:.68rem;text-transform:uppercase;letter-spacing:.04em">
              <th style="padding:8px 10px;text-align:left;width:36px">#</th>
              <th style="padding:8px 10px;text-align:left">Player</th>
              <th style="padding:8px 6px;text-align:center;border-left:1px solid var(--border)">Group</th>
              <th style="padding:8px 4px;text-align:center;border-left:1px solid var(--border)">R32</th>
              <th style="padding:8px 4px;text-align:center">R16</th>
              <th style="padding:8px 4px;text-align:center">QF</th>
              <th style="padding:8px 4px;text-align:center">SF</th>
              <th style="padding:8px 4px;text-align:center">3rd/Final</th>
              <th style="padding:8px 4px;text-align:center;border-left:1px solid var(--border)">Bonus</th>
              <th style="padding:8px 10px;text-align:right;border-left:1px solid var(--border)">Total</th>
              <th style="padding:8px 10px;text-align:right;border-left:1px solid var(--border)">Prize</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((r, i) => {
              const prizeDisplay = r.prize
                ? (Number.isInteger(r.prize) ? r.prize : r.prize.toFixed(1))
                : '—';
              const prizeColor = r.prize ? 'var(--gold)' : 'var(--muted)';
              const ko = currentStage === 'ko';
              const dim = 'var(--text-dim)';
              const active = 'var(--text)';
            %>
            <tr style="border-top:1px solid var(--border);<%= r.id === myId ? 'background:rgba(59,130,246,.12);' : (i%2===0?'':'background:rgba(255,255,255,.015);') %>">
              <td style="padding:10px 10px;font-weight:700;color:<%= r.rank<=3 ? 'var(--gold)' : dim %>">
                <% if (r.rank===1) { %>🥇<% } else if (r.rank===2) { %>🥈<% } else if (r.rank===3) { %>🥉<% } else { %><%= r.rank %><% } %>
              </td>
              <td style="padding:10px 10px">
                <strong style="color:<%= r.id===myId ? 'var(--gold)' : active %>"><%= r.display_name %></strong>
                <% if (r.id===myId) { %><span style="font-size:.65rem;color:var(--accent);margin-left:4px">you</span><% } %>
              </td>
              <td style="padding:10px 6px;text-align:center;border-left:1px solid var(--border);color:<%= ko ? dim : active %>"><%= r.group_pts %></td>
              <td style="padding:10px 4px;text-align:center;border-left:1px solid var(--border);color:<%= ko ? active : dim %>"><%= r.r32_pts || '—' %></td>
              <td style="padding:10px 4px;text-align:center;color:<%= ko ? active : dim %>"><%= r.r16_pts || '—' %></td>
              <td style="padding:10px 4px;text-align:center;color:<%= ko ? active : dim %>"><%= r.qf_pts || '—' %></td>
              <td style="padding:10px 4px;text-align:center;color:<%= ko ? active : dim %>"><%= r.sf_pts || '—' %></td>
              <td style="padding:10px 4px;text-align:center;color:<%= ko ? active : dim %>"><%= r.final_pts || '—' %></td>
              <td style="padding:10px 4px;text-align:center;border-left:1px solid var(--border);color:<%= ko ? 'var(--gold)' : dim %>"><%= r.bonus_pts || '—' %></td>
              <td style="padding:10px 10px;text-align:right;font-weight:800;font-size:.95rem;color:<%= r.id===myId ? 'var(--gold)' : active %>;border-left:1px solid var(--border)"><%= r.total %></td>
              <td style="padding:10px 10px;text-align:right;font-weight:700;font-size:.85rem;color:<%= prizeColor %>;border-left:1px solid var(--border)"><%= prizeDisplay %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <div class="card mt-24" style="padding:14px 18px">
      <div style="font-size:.78rem;color:var(--text-dim);line-height:1.7">
        📋 <strong style="color:var(--text)">Scoring:</strong>
        Group 1pt · R32 2pts · R16 3pts · QF 4pts · SF 5pts · Final 6pts
        · <span style="color:var(--gold)">⭐ +1 AET bonus (knockout)</span>
      </div>
      <div style="font-size:.78rem;color:var(--text-dim);line-height:1.7;margin-top:6px">
        🏆 <strong style="color:var(--text)">Prize Pool:</strong>
        <span style="color:var(--gold)">🥇 200 KD</span> · <span style="color:var(--text)">🥈 80 KD</span> · <span style="color:var(--text)">🥉 50 KD</span>
        · Prize column shows projected payout based on current standings.
        Ties split combined prizes equally. <a href="/rules#prizes" style="color:var(--accent);text-decoration:none">See rules →</a>
      </div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
